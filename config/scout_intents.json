{
  "_note": "ClinAssist implementation of the Meterless Scout Intent spec (sense, interpret, guard, route, recommend). Patterns are case-insensitive regular expressions with weights. Synthetic-data demonstration; every approved request still ends with a clinician's review.",
  "version": "2026-10-26.1",
  "lanes": {
    "planner": "meterless/fast",
    "writer": "meterless/deep",
    "judge": "meterless/judge"
  },
  "scoring": {
    "min_score": 2.0,
    "secondary_ratio": 0.6,
    "contract_ttl_minutes": 15
  },
  "intents": {
    "summary.previsit": {
      "description": "Evidence-linked pre-visit summary of the patient's history",
      "patterns": [["\\bsumm?ar(y|ies|i[sz]e|i[sz]ing)\\b", 3], ["\\bpre-?visit\\b", 3], ["\\boverview\\b", 3], ["\\bbrief(ing)?\\b", 2],
                   ["\\bwrite[- ]?up\\b", 2], ["\\bhistory\\b", 1]],
      "tools": [{"tool": "findings", "args": {}}, {"tool": "trends", "args": {"analytes": ["egfr", "creatinine", "hba1c", "potassium"]}},
                {"tool": "medications", "args": {"active_only": true}}, {"tool": "problems", "args": {}},
                {"tool": "timeline", "args": {}}, {"tool": "identity", "args": {}}],
      "roles": ["clinician", "coordinator"]
    },
    "finding.explain": {
      "description": "Explain why a finding or alert was raised, with its evidence",
      "patterns": [["\\bexplain\\w*\\b", 3], ["\\bwhy\\b", 2], ["\\b(alert|flag|finding|warning)s?\\b", 2], ["\\bwhat does .{0,40}\\bmean\\b", 2],
                   ["\\bunderstand\\b", 2]],
      "tools": [{"tool": "findings", "args": {}}, {"tool": "trends", "args": {}}, {"tool": "timeline", "args": {}}],
      "roles": ["clinician", "coordinator"]
    },
    "medication.review": {
      "description": "Review the medicine list: stale, duplicate, kidney-unsafe, allergy clashes",
      "patterns": [["\\bmedic(ation|ine)s?\\b", 3], ["\\bdrugs?\\b", 2], ["\\bprescriptions?\\b", 2], ["\\bduplicat\\w*\\b", 1.5],
                   ["\\ballerg(y|ies|ic)\\b", 2], ["\\b(statins?|metformin|lisinopril|alendron\\w*|insulin|amlodipine)\\b", 1]],
      "tools": [{"tool": "medications", "args": {"active_only": false}}, {"tool": "findings", "args": {}},
                {"tool": "trends", "args": {"analytes": ["egfr", "potassium"]}}, {"tool": "problems", "args": {}}],
      "roles": ["clinician"]
    },
    "trend.review": {
      "description": "How one or more lab values or vital signs changed over time",
      "patterns": [["\\btrends?\\b", 3], ["\\bover (time|the (last|past))\\b", 2], ["\\bchang(e|ed|es|ing)\\b", 1.5], ["\\bkidney function\\b", 1.5],
                   ["\\b(egfr|hba1c|a1c|potassium|creatinine|glucose|sodium|ldl|cholesterol|ha?emoglobin|blood pressure)\\b", 1]],
      "tools": [{"tool": "trends", "args": {}}, {"tool": "findings", "args": {}}],
      "roles": ["clinician", "coordinator"]
    },
    "gaps.review": {
      "description": "Monitoring tests that are missing or overdue",
      "patterns": [["\\bmissing\\b", 3], ["\\boverdue\\b", 3], ["\\bmonitoring\\b", 2], ["\\bnot been (done|checked|tested)\\b", 2], ["\\bdue\\b", 1]],
      "tools": [{"tool": "findings", "args": {}}, {"tool": "problems", "args": {}}, {"tool": "trends", "args": {}}],
      "roles": ["clinician", "coordinator"]
    },
    "identity.review": {
      "description": "Which source records are linked to the patient and which matches await a person",
      "patterns": [["\\bidentit(y|ies)\\b", 3], ["\\b(linked|source) records?\\b", 3], ["\\bpending\\b", 1.5], ["\\bmatch(es|ing)?\\b", 1.5],
                   ["\\bmerge[ds]?\\b", 1]],
      "tools": [{"tool": "identity", "args": {}}],
      "roles": ["clinician", "coordinator", "records_staff"]
    }
  },
  "analyte_words": {
    "egfr": ["egfr", "kidney function", "renal function"],
    "creatinine": ["creatinine", "kidney function", "renal function"],
    "hba1c": ["hba1c", "a1c", "sugar control", "diabetes control"],
    "glucose": ["glucose", "blood sugar"],
    "potassium": ["potassium"],
    "sodium": ["sodium"],
    "ldl": ["ldl", "cholesterol"],
    "hemoglobin": ["haemoglobin", "hemoglobin", "anaemia", "anemia"],
    "acr": ["albumin", "acr"],
    "sbp": ["blood pressure", "bp", "systolic"],
    "dbp": ["blood pressure", "bp", "diastolic"]
  },
  "guards": {
    "injection": [
      "\\bignore\\b.{0,30}\\b(instructions?|rules?|prompt|guidelines?|polic(y|ies))\\b",
      "\\bdisregard\\b.{0,30}\\b(instructions?|rules?|prompt|guidelines?|checks?)\\b",
      "\\b(system|hidden|initial|original) (prompt|instructions?)\\b",
      "\\byou are now\\b", "\\bact as\\b", "\\bpretend\\b",
      "\\b(turn off|disable|bypass|skip|switch off)\\b.{0,20}\\b(verif\\w*|fact[- ]?check\\w*|checks?|checker|safety|guard\\w*|citations?|scout)\\b",
      "\\bwithout (any )?(citations?|checks?|verification)\\b",
      "\\braw (ai|model|llm) (text|output|answer)\\b",
      "\\b(api[ _-]?keys?|passwords?|tokens?|secrets?|credentials?)\\b", "\\.env\\b"
    ],
    "clinical_decision": [
      "\\bdiagnos(e|ing)\\b", "\\b(his|her|their|the|a) diagnosis\\b", "\\bwhat is wrong with\\b",
      "\\bprescrib(e|ing)\\b", "\\b(dose|dosage|dosing)\\b",
      "\\bshould (i|we|he|she|they)\\b.{0,25}\\b(start|stop|increase|decrease|reduce|switch|change|give|continue|discontinue|add|use)\\b",
      "\\brecommend\\w*\\b.{0,20}\\b(treatment|therapy|medication|medicine|drug|plan)\\b",
      "\\btreatment plan\\b", "\\bwhat (treatment|medication|medicine|drug|therapy)\\b.{0,20}\\b(should|to)\\b"
    ],
    "bulk_data": [
      "\\b(all|every|each)( of the)? patients?\\b", "\\bexport\\b", "\\b(download|dump)\\b", "\\bwhich patients\\b",
      "\\bpatients (with|who|that)\\b", "\\bdatabase\\b", "\\blist (of )?(all )?patients\\b"
    ],
    "other_patient_words": ["\\b(another|other|different) patients?\\b"]
  },
  "messages": {
    "clinical-decision": "ClinAssist supports a clinician's review; it does not diagnose, prescribe or recommend treatment. I can summarise the evidence or explain a finding instead.",
    "injection": "This request tries to change ClinAssist's safety rules or reveal protected information, so it was not run.",
    "wrong-patient": "This session is limited to the selected patient. Open the other patient's record to ask about them.",
    "bulk-data": "ClinAssist works on one selected patient at a time; population-wide lists and exports are outside its scope.",
    "role-not-permitted": "Your role is not permitted to run this kind of request.",
    "clarify": "I'm not sure what you need. Choose one: a pre-visit summary, an explanation of a finding, a medicine review, a trend, missing tests, or the linked records."
  }
}
