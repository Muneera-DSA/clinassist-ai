# Copy this file to .env and fill in real values. Never commit .env.

# --- DATA: Zetaris (local Docker install) ---
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=create-in-zetaris-web-ui

# --- POWER: Meterless Nightshift Runtime (values from Nightshift > Console) ---
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=copy-from-nightshift-console
METERLESS_APP=clinassist-ai
# Use an id from GET /v1/models (smoke_test.py prints them). Pin explicit cloud ids
# so the runtime cannot fall back to a local WebLLM lane; routing modes such as
# meterless/fast may resolve to the on-device model.
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
METERLESS_MODEL_DEEP=nvidia/nemotron-3-ultra-550b-a55b

# --- SCOUT: key that signs execution contracts (any long random string; keep it secret) ---
# Generate one with:  .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
SCOUT_SIGNING_KEY=change-me-to-a-long-random-string

# Optional agent settings (defaults shown; leave out to use them)
# Reply budget for every Nemotron call. Lightning may reason at length even with thinking off; a small budget
# returns an empty reply. 8000 answered reliably in testing (26 Oct).
AGENT_MAX_TOKENS=8000
# 1 = start the boss, writer and judge instructions with /no_think (Nemotron text switch); 0 = off
AGENT_NO_THINK=1
