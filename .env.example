# Copy this file to .env and fill in real values. Never commit .env.

# --- DATA: Zetaris (local Docker install) ---
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=create-in-zetaris-web-ui

# --- POWER: Meterless Nightshift Runtime (values from Nightshift > Console) ---
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=copy-from-nightshift-console
METERLESS_APP=clinassist-ai
# Use an id from GET /v1/models (smoke_test.py prints them). Nightshift may expose
# routing modes (meterless/fast, meterless/deep) rather than raw model names; then
# make sure the matching lane is a Nemotron model in Nightshift > NIGHT > LANES.
METERLESS_MODEL=meterless/fast
METERLESS_MODEL_DEEP=meterless/deep
