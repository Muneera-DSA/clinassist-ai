# Copy to sources/.env and set your own passwords. Never commit sources/.env.
# Each system has an ADMIN account (loads the data, never given to anyone) and a
# READ-ONLY account (the only one Zetaris uses).
#
# SQL Server rule: the HOSPITAL_ADMIN_PASSWORD must be at least 8 characters and contain
# 3 of: upper case, lower case, digit, symbol - otherwise the container will not start.
# Avoid single quotes ' and double quotes " in all passwords.

# Hospital EHR - Microsoft SQL Server 2022 (port 55432)
HOSPITAL_ADMIN_PASSWORD=Change-me-Hosp1
HOSPITAL_DB_USER=hospital_ro
HOSPITAL_DB_PASSWORD=change-me-hospital-ro

# Laboratory LIS - MySQL 8.4 (port 55433)
LAB_ADMIN_PASSWORD=change-me-lab-admin
LAB_DB_USER=lab_ro
LAB_DB_PASSWORD=change-me-lab-ro

# Pharmacy - PostgreSQL 16 (port 55434)
PHARMACY_ADMIN_USER=pharmacy_admin
PHARMACY_ADMIN_PASSWORD=change-me-pharmacy-admin
PHARMACY_DB_USER=pharmacy_ro
PHARMACY_DB_PASSWORD=change-me-pharmacy-ro
